# Cloudflare static-asset headers. Agent-facing files are readable from any
# origin, so scripts and tools on other sites can fetch them.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

# Markdown remains Markdown in content, but plain text is compatible with AI readers.
/skills/*.md
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/api/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/schemas/*
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *

/js/*
  Access-Control-Allow-Origin: *
