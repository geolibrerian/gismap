{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gismap.online/schemas/briefing-v1.schema.json",
  "title": "GISMap Briefing",
  "description": "A portable, client-side GISMap briefing document.",
  "type": "object",
  "required": [
    "schemaVersion",
    "slides"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "description": "The layer the briefing is about. Use the layer's service URL (for example https://\u2026/FeatureServer/0) so the document works anywhere; GISMap loads it when it is not on the map. A layer ID or title also matches a layer that is already loaded."
    },
    "transition": {
      "enum": [
        "pan",
        "cut"
      ],
      "default": "pan",
      "description": "How the map moves between slides: pan flies from one view to the next; cut jumps straight there (better when slides are far apart)."
    },
    "queries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,40}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/filter"
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "useAll": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "description": "Features the briefing is about: their IDs (the layer's object ID values) or useAll for every feature matching the filters."
    },
    "slides": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "filter": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "not_in",
            "contains",
            "starts_with",
            "is_null",
            "is_not_null",
            "and",
            "or",
            "not",
            "feature_ids"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {},
        "values": {
          "type": "array",
          "maxItems": 200
        },
        "ids": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "args": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "arg": {
          "$ref": "#/$defs/filter"
        }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": [
        "center",
        "zoom",
        "heading",
        "tilt"
      ],
      "properties": {
        "center": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "heading": {
          "type": "number"
        },
        "tilt": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "markdown": {
          "type": "string",
          "maxLength": 4000
        },
        "queryRef": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "stat": {
          "enum": [
            "count",
            "sum",
            "average",
            "min",
            "max"
          ]
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "items": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "links": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "required": [
        "id",
        "template",
        "title",
        "blocks",
        "hidden"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "template": {
          "enum": [
            "title",
            "feature",
            "map-narrative",
            "key-numbers",
            "actions"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "subtitle": {
          "type": "string",
          "maxLength": 160
        },
        "featureId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/camera"
            },
            {
              "type": "null"
            }
          ]
        },
        "fit": {
          "enum": [
            "feature",
            "selection",
            null
          ]
        },
        "blocks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "hidden": {
          "type": "boolean"
        },
        "layers": {
          "type": "array",
          "maxItems": 10,
          "description": "The briefing's other layers on this slide. Each is shown or hidden, and can show only the features with a spatial relationship to the slide's feature (as an ArcGIS REST query's spatialRel). Layers not listed stay as the map has them; without this property the slide changes no other layer.",
          "items": {
            "type": "object",
            "required": [
              "layer"
            ],
            "properties": {
              "layer": {
                "type": "string",
                "maxLength": 2048,
                "description": "The layer's service URL (or layer ID or title)."
              },
              "visible": {
                "type": "boolean",
                "default": true
              },
              "relation": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "intersects",
                      "contains",
                      "crosses",
                      "envelope-intersects",
                      "index-intersects",
                      "overlaps",
                      "touches",
                      "within",
                      "disjoint",
                      "relation"
                    ],
                    "description": "How the layer's features relate to the slide's feature. contains: features inside it; within: features that contain it; envelope-intersects: features touching its bounding box; relation: the DE-9IM pattern in relationParameter."
                  },
                  "distance": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Grow the slide's feature by this distance first (for example, wells within 500 meters)."
                  },
                  "units": {
                    "enum": [
                      "meters",
                      "kilometers",
                      "feet",
                      "miles",
                      "nautical-miles",
                      "us-nautical-miles"
                    ],
                    "default": "meters"
                  },
                  "relationParameter": {
                    "type": "string",
                    "pattern": "^[TFtf*012]{9}$",
                    "description": "A DE-9IM pattern such as T******** (for type relation)."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "dataView": {
          "description": "Optional layer subset used by a data-driven map slide.",
          "type": "object",
          "required": [
            "layer",
            "filter"
          ],
          "properties": {
            "layer": {
              "type": "string",
              "minLength": 1
            },
            "filter": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "op",
                    "field",
                    "values"
                  ],
                  "properties": {
                    "op": {
                      "const": "in"
                    },
                    "field": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
                    },
                    "values": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": [
                          "string",
                          "number"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "op",
                    "field",
                    "start",
                    "end"
                  ],
                  "properties": {
                    "op": {
                      "const": "year-range"
                    },
                    "field": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9999
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
