{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gismap.online/schemas/cinematic.schema.json",
  "title": "GISMap Cinematic 0.1",
  "type": "object",
  "required": ["schemaVersion", "mode", "cinematic"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "mode": { "const": "cinematic" },
    "cinematic": {
      "type": "object",
      "required": ["id", "title", "clock", "layers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "intent": { "enum": ["explore", "investigate", "present"] },
        "clock": {
          "type": "object",
          "required": ["durationSeconds"],
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" },
            "current": { "type": "string" },
            "timeMode": { "enum": ["instant", "cumulative"] },
            "durationSeconds": { "type": "number", "minimum": 1, "maximum": 600 },
            "rate": { "type": "number", "minimum": 0.1, "maximum": 4 },
            "loop": { "type": "boolean" }
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["layerRef", "temporal"],
            "properties": {
              "layerRef": { "type": "string" },
              "temporal": {
                "type": "object",
                "required": ["startField"],
                "properties": {
                  "startField": { "type": "string" },
                  "groupField": { "type": "string" },
                  "featureIdField": { "type": "string" }
                }
              },
              "animation": {
                "type": "object",
                "properties": {
                  "template": { "enum": ["step-perimeter", "moving-track"] },
                  "transition": { "enum": ["step", "crossfade"] },
                  "opacity": { "type": "number", "minimum": 0.05, "maximum": 1 },
                  "outline": {
                    "type": "object",
                    "properties": {
                      "color": { "type": "string" },
                      "glow": { "type": "boolean" }
                    }
                  },
                  "effect": {
                    "type": "object",
                    "description": "Decorative animation drawn on observed geometry; never data. 'auto' picks one from the layer title, geometry and fields.",
                    "properties": {
                      "type": { "enum": ["auto", "none", "glow", "fire", "pulse", "wind", "snow", "lightning", "tornado", "hurricane", "storm", "water", "water-flow", "flow", "electricity", "traffic", "trains", "sailboats", "ships", "birds", "drones", "airplanes", "helicopters", "extrude", "reveal"] },
                      "color": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
                      "intensity": { "type": "number", "minimum": 0.25, "maximum": 2 },
                      "field": { "type": "string", "maxLength": 160 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
