{
  "$comment": "Generated by scripts/build-examples.mjs from js/share.js. Query parameters go after ?, fragment parameters after #.",
  "base": "https://gismap.online/",
  "limits": {
    "maxLayers": 10,
    "readableMapSpecCharacters": 8192,
    "qrSafeUrlLength": 2800
  },
  "query": {
    "layer": {
      "type": "string",
      "format": "uri",
      "repeatable": true,
      "maxItems": 10,
      "description": "HTTPS URL of a public layer, service or GeoJSON file. No tokens or keys.",
      "example": "https://services.arcgis.com/P3ePLMYs2RVChkJx/ArcGIS/rest/services/Corn/FeatureServer/0"
    },
    "layerType": {
      "type": "string",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "Layer type; arcgis-auto detects it.",
      "example": "feature",
      "values": [
        "arcgis-auto",
        "feature",
        "map-image",
        "imagery",
        "geojson",
        "wms",
        "wfs",
        "kml"
      ],
      "default": "arcgis-auto"
    },
    "title": {
      "type": "string",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "Layer title.",
      "example": "Corn sales"
    },
    "where": {
      "type": "string",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "Read-only SQL filter on the layer's fields.",
      "example": "CORN_SALES_IN_DOLLARS >= 0"
    },
    "style": {
      "type": "string",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "A style without JSON.",
      "example": "choropleth",
      "values": [
        "service",
        "simple",
        "choropleth",
        "graduated",
        "categories",
        "heatmap"
      ]
    },
    "field": {
      "type": "string",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "The field a style uses (exactly as the service names it).",
      "example": "CORN_SALES_IN_DOLLARS"
    },
    "classes": {
      "type": "integer",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "Number of classes for choropleth and graduated styles.",
      "example": "5",
      "minimum": 2,
      "maximum": 9
    },
    "ramp": {
      "type": "string",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "A named colour ramp.",
      "example": "greens",
      "values": [
        "greens",
        "blues",
        "reds",
        "oranges",
        "purples",
        "viridis",
        "magma",
        "red-blue-diverging",
        "brown-teal-diverging"
      ]
    },
    "exclude": {
      "type": "string",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "Comma-separated codes drawn as \"No data\" and kept out of the classes.",
      "example": "-1"
    },
    "color": {
      "type": "string",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "Hex colour for simple and graduated styles.",
      "example": "d9951e"
    },
    "opacity": {
      "type": "number",
      "repeatable": true,
      "indexAligned": "layer",
      "description": "0 (transparent) to 1 (opaque).",
      "example": "0.8",
      "minimum": 0,
      "maximum": 1
    },
    "basemap": {
      "type": "string",
      "values": [
        "topo-3d",
        "navigation-3d",
        "navigation-dark-3d",
        "osm-3d",
        "gray-3d",
        "dark-gray-3d",
        "streets-3d",
        "streets-dark-3d",
        "topo-vector",
        "streets-vector",
        "navigation",
        "gray-vector",
        "dark-gray-vector",
        "osm",
        "satellite",
        "hybrid"
      ],
      "description": "The background map, applied before the scene starts.",
      "example": "gray-vector"
    },
    "zoom": {
      "type": "string",
      "values": [
        "layers",
        "none"
      ],
      "default": "layers",
      "description": "layers fits the loaded data; none keeps the starting view.",
      "example": "none"
    },
    "center": {
      "type": "string",
      "pattern": "lon,lat",
      "description": "View centre in degrees; use with scale or level.",
      "example": "-93.6,42"
    },
    "scale": {
      "type": "number",
      "minimum": 1,
      "description": "Map scale denominator, with center.",
      "example": "500000"
    },
    "level": {
      "type": "number",
      "minimum": 0,
      "maximum": 24,
      "description": "Zoom level, with center.",
      "example": "7"
    },
    "example": {
      "type": "string",
      "values": [
        "usa-wildfires",
        "modis-active-fires",
        "active-hurricanes",
        "recent-hurricanes",
        "air-quality-pm25",
        "air-quality-pm25-3d-columns",
        "air-quality-pm25-3d-graduated",
        "usgs-seismic-activity",
        "usgs-recent-earthquakes-map-service",
        "ndfd-wind-gusts",
        "ndfd-precipitation",
        "ndfd-daily-temperature",
        "historical-quakes",
        "usgs-earthquakes",
        "world-countries-generalized"
      ],
      "description": "A curated dataset (see /api/catalog.json).",
      "example": "usa-wildfires"
    },
    "spec": {
      "type": "string",
      "format": "uri",
      "description": "HTTPS URL of a CORS-enabled map-v1 JSON file.",
      "example": "https://example.org/corn.map.json"
    },
    "briefing": {
      "type": "string",
      "format": "uri",
      "description": "HTTPS URL of a briefing file (briefing-v1 document, project or the app's briefing file).",
      "example": "https://example.org/corn.briefing.json"
    }
  },
  "fragment": {
    "map": {
      "type": "string",
      "description": "json:<URI-encoded map-v1 JSON> (readable, at most 8192 characters) or the compressed z… form from mapSpec.createLink.",
      "example": "json:%7B%22version%22%3A1%2C%22basemap%22%3A%22gray-vector%22%2C%22layers%22%3A%5B%7B%22url%22%3A%22https%3A%2F%2Fservices.arcgis.com%2FP3ePLMYs2RVChkJx%2FArcGIS%2Frest%2Fservices%2FCorn%2FFeatureServer%2F0%22%2C%22renderer%22%3A%7B%22type%22%3A%22choropleth%22%2C%22field%22%3A%22CORN_SALES_IN_DOLLARS%22%2C%22ramp%22%3A%22greens%22%2C%22exclude%22%3A%5B-1%5D%7D%7D%5D%7D"
    },
    "briefing": {
      "type": "string",
      "description": "A briefing link payload (from the app or briefing.createLink)."
    },
    "slide": {
      "type": "string",
      "description": "Open a briefing at this slide id."
    }
  }
}
