{
  "name": "GISMap Field Mode",
  "short_name": "GISMap Field",
  "description": "Offline-first local field observations for GISMap.",
  "id": "/field/",
  "start_url": "/field/",
  "scope": "/field/",
  "display": "standalone",
  "background_color": "#123e35",
  "theme_color": "#123e35",
  "icons": [
    { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [{ "action": "/field/", "accept": { "application/vnd.gismap.field+json": [".gisfield"], "application/vnd.gismap.geopayload+json": [".geopayload"] } }]
}
